# 建置產物(不提交)
build/
DerivedData/
*.xcarchive
Payload/
*.ipa
*.dSYM
*.dSYM.zip
*.xcresult
_site/

# Xcode 使用者狀態
xcuserdata/
*.xcuserstate
*.swp
.DS_Store

# SPM / Carthage / Pods
.build/
Carthage/
Pods/

# 本機工具
*.log

# Stage A 轉換器產物(不提交;轉換輸出應放在本機或 CI 工作區)
# 分塊輸出目錄通常名為 *_chunks*、chunks_out 等
*_chunks*/
chunks_out/
*_osgb_extract/
# 轉換器工作目錄
_work/
_tmp_*/
# 任何 .glb / manifest.json 若落在儲存庫內一律忽略(應由轉換器產生於輸出目錄)
/*.glb
/*.gltf
/manifest.json
# osgconv/pyfkml 測試產出的紋理(防漏到根目錄)
/11-NW-*.jpg
/Tile_*.jpg
/Tile_*.png
# OSGB 來源檔(1.7 GB+,永不提交)
*.osgb
*.osgb.zip
*.osgb.7z
# CSDI 圖幅 zip(使用者會放到儲存庫根目錄,永不提交)
/11-NW-*.zip
/11-NE-*.zip
/11-SW-*.zip
/11-SE-*.zip
# 解壓後的圖幅目錄
/11-NW-*_osgb_extract/
/11-NE-*_osgb_extract/
/11-SW-*_osgb_extract/
/11-SE-*_osgb_extract/

# Unity 專案產物(Stage B/C)
codebase/unity-project/Library/
codebase/unity-project/Temp/
codebase/unity-project/Obj/
codebase/unity-project/Build/
codebase/unity-project/Builds/
codebase/unity-project/Logs/
codebase/unity-project/UserSettings/
codebase/unity-project/MemoryCaptures/
codebase/unity-project/Recordings/
# Unity 自動產生的解決方案/專案檔(由 Unity 重新產生)
codebase/unity-project/*.csproj
codebase/unity-project/*.sln
codebase/unity-project/*.unityproj
codebase/unity-project/*.user
codebase/unity-project/.vs/
codebase/unity-project/.vsconfig
# Unity Xcode 匯出(Stage C,由建置產生)
codebase/unity-project/Unity-iPhone/
codebase/unity-project/export/
# Stage A 分塊資料(由轉換器產生,複製進 StreamingAssets 供 Stage B 串流測試)
# 永不提交:可由 Stage A 重新生成,且檔案大(11-NW-15B 約 14 MB)
codebase/unity-project/Assets/StreamingAssets/Chunks/
codebase/unity-project/Assets/StreamingAssets/Chunks.meta
# 分塊資料 / Xcode 匯出 tarball(上傳至 GitHub Release,不提交 git)
/chunks-*.tar.gz
/xcode-export-*.tar.gz
# Unity / Tuanjie 授權檔(機密,永不提交;涵蓋 .ulf 與 .alf 格式)
*.ulf
*.ulf.txt
*.alf
*.alf.txt
Unity_v*.ulf
Tuanjie_v*.ulf
Tuanjie_v*.alf
# Tuanjie 授權相關(Sentinel HASP / 授權快取,同樣不提交)
*.hasp
*.hasp_dump
Tuanjie_*.json.lock
